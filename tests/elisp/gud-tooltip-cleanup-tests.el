;;; B011 disabling GUD tooltips cleans owned hooks even with ordinary tips. -*- lexical-binding: t; -*-
(load (expand-file-name "debugger-fixture.el" (file-name-directory load-file-name)) nil nil t)
(require 'tooltip)
(ert-deftest tooltip-disable-cleans-all-sources-and-restores-mouse-binding ()
  (dolist (ordinary '(nil t))
    (let ((sources (list (generate-new-buffer "tip-a.c") (generate-new-buffer "tip-b.c")))
          (global-map (make-sparse-keymap)) (tooltip-mode ordinary)
          (change-major-mode-hook nil) (pre-command-hook nil) (tooltip-functions nil)
          (gud-tooltip-mode nil))
      (unwind-protect
          (with-temp-buffer
            (let ((gud-comint-buffer (current-buffer)))
              (setq-local gud-minor-mode 'gdba)
              (define-key global-map [mouse-movement] 'prior-mouse-binding)
              (dolist (source sources)
                (with-current-buffer source (setq-local gud-minor-mode 'gdba)
                                     (add-hook 'after-save-hook 'ignore nil t)))
              (cl-letf (((symbol-function 'gud-tooltip-activate-mouse-motions-if-enabled) #'ignore)
                        ((symbol-function 'gdb-create-define-alist) #'ignore))
                (gud-tooltip-mode 1)
                (dolist (source sources)
                  (with-current-buffer source (should (memq 'gdb-create-define-alist after-save-hook))))
                (gud-tooltip-mode -1))
              (should-not (memq 'gud-tooltip-change-major-mode change-major-mode-hook))
              (should-not (memq 'gud-tooltip-tips tooltip-functions))
              (should (eq (lookup-key global-map [mouse-movement]) 'prior-mouse-binding))
              (should (eq (not (null (memq 'tooltip-hide pre-command-hook))) ordinary))
              (dolist (source sources)
                (with-current-buffer source
                  (should-not (memq 'gdb-create-define-alist after-save-hook))
                  (should (memq 'ignore after-save-hook))))))
        (mapc #'kill-buffer sources)))))
(ert-run-tests-batch-and-exit)
