;;; B011 completion must terminate and tolerate short diagnostics. -*- lexical-binding: t; -*-
(load (expand-file-name "debugger-fixture.el" (file-name-directory load-file-name)) nil nil t)
(defvar gud-gdb-fetch-lines-string nil)
(defvar gud-gdb-fetch-lines-break 0)
(defvar gud-gdb-fetched-lines nil)
(defvar gud-gdb-fetch-lines-in-progress nil)
(ert-deftest completion-short-diagnostic-does-not-overrun-skip-offset ()
  (let ((gud-gdb-fetch-lines-string nil) (gud-gdb-fetch-lines-break 7)
        (gud-gdb-fetched-lines nil) (gud-gdb-fetch-lines-in-progress t)
        (comint-prompt-regexp "^(gdb) "))
    (should (equal (gud-gdb-fetch-lines-filter23 "bad\nprefix candidate\n(gdb) " #'identity) "(gdb) "))
    (should (equal (nreverse gud-gdb-fetched-lines) '("bad" "candidate")))
    (should-not gud-gdb-fetch-lines-in-progress)))

(ert-deftest completion-dead-process-and-missing-prompt-terminate ()
  (dolist (mode '(dead midflight timeout success))
    (with-temp-buffer
      (let ((gud-comint-buffer (current-buffer)) (gud-marker-filter #'identity)
            (gud-gdb-fetch-lines-timeout 1.0) (comint-prompt-regexp "^(gdb) ")
            (ticks 0) (polls 0))
        (cl-letf (((symbol-function 'get-buffer-process) (lambda (_) 'fixture-process))
                  ((symbol-function 'process-live-p)
                   (lambda (_) (not (or (eq mode 'dead) (and (eq mode 'midflight) (> polls 0))))))
                  ((symbol-function 'float-time) (lambda (&rest _) (prog1 ticks (setq ticks (+ ticks 0.1)))))
                  ((symbol-function 'gud-basic-call) #'ignore)
                  ((symbol-function 'accept-process-output)
                   (lambda (&rest _)
                     (setq polls (1+ polls))
                     (when (> polls 20) (error "Unbounded completion polling"))
                     (when (eq mode 'success) (funcall gud-marker-filter "candidate\n(gdb) ")))))
          (if (eq mode 'success)
              (should (equal (gud-gdb-run-command-fetch-lines "complete p" nil) '("candidate")))
            (should-error (gud-gdb-run-command-fetch-lines "complete p" nil) :type 'user-error)))
        (should (eq gud-marker-filter #'identity))))))
(ert-run-tests-batch-and-exit)
